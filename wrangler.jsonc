{
  "name": "ten-bagger",
  "compatibility_date": "2026-05-22",
  "routes": [
    { "pattern": "simpleornothing.com", "custom_domain": true }
  ],
  // worker-entry.js는 기존 worker-hotfix.js의 fetch 정책을 유지하면서 scheduled 이벤트를 worker.js로 위임한다.
  "main": "worker-entry.js",
  "triggers": {
    // Cloudflare Cron은 UTC 기준. 08:00 UTC = 17:00 Asia/Seoul.
    "crons": ["0 8 * * *"]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Run Worker before serving any asset so the password gate also covers the .json data files.
    "run_worker_first": true
  },
  // 메모·자산현황 이력 저장용 R2 영구 저장소.
  "r2_buckets": [
    { "binding": "MEMO_BUCKET", "bucket_name": "ten-bagger-memo" }
  ]
}
