{
  "name": "ten-bagger",
  "compatibility_date": "2026-05-22",
  "routes": [
    { "pattern": "simpleornothing.com", "custom_domain": true }
  ],
  // worker-entry.js는 기존 worker-hotfix.js의 fetch 정책을 유지하고 자산현황 이력 UI를 주입한다.
  // 17:00 KST 저장 일정은 Cloudflare Free cron 한도(계정당 5개)를 소모하지 않도록 GitHub Actions에서 실행한다.
  "main": "worker-entry.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Run Worker before serving any asset so the password gate also covers the .json data files.
    "run_worker_first": true
  },
  // 메모·자산현황 이력 저장용 R2 영구 저장소.
  "r2_buckets": [
    { "binding": "MEMO_BUCKET", "bucket_name": "ten-bagger-memo" }
  ]
}
